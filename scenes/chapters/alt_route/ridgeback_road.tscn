[node name="RidgebackRoad" type="Node3D"]
editor_description = "The alt route's road past the yard gate: fenced off on both sides, blocked with wrecked cars in rows that each leave one way through, and a pack of Ridgebacks that leap between them. Placed at the world origin, so every child sits at its world position. Written by a layout script; hand-maintained since."
