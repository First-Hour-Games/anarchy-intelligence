[node name="ShedInterior" type="Node3D"]
editor_description = "The alt route's shed: the garage across the road from the gas station, dressed and lit. Placed at the world origin, so every child sits at its world position. The garage's own mesh and collision swap to the doorless shed versions in starting_forest_alt.tscn. The shed's inside and everything in it but the door are drawn on render layer 12, which the pump sign's light leaves out and the bench lamp alone lights; see shed_interior.gd and tools/build_shed_meshes.gd."
script = ExtResource("0_shed")

