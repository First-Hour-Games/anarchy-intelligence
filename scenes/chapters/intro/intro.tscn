[sub_resource type="GDScript" id="GDScript_kkc3u"]
script/source = "extends Camera3D

@export_group(\"Handheld Motion\")
## Overall speed of the handheld movement (lower = slower, calmer sway)
@export var motion_speed: float = 1.0
## Maximum pitch tilt up and down in degrees
@export var max_pitch_deg: float = 3.0
## Maximum subtle horizontal sway in degrees
@export var max_yaw_deg: float = 0.7
## Maximum subtle wrist roll in degrees
@export var max_roll_deg: float = 0.5
## Interpolation smoothing factor for rotation (higher = snappier, lower = smoother lag)
@export var rotation_smoothing: float = 4.0

@export_group(\"Handheld Bobbing\")
## Subtle vertical bobbing in meters (e.g. 0.02 = 2 cm)
@export var vertical_amplitude: float = 0.02
## Subtle horizontal bobbing in meters (e.g. 0.01 = 1 cm)
@export var horizontal_amplitude: float = 0.01
## Interpolation smoothing factor for positional offsets
@export var position_smoothing: float = 4.0

@export_group(\"Noise Settings\")
## The FastNoiseLite resource driving organic handheld drift
@export var noise: FastNoiseLite
## Optional: You can also assign a NoiseTexture2D here and its noise will be used.
@export var noise_texture: NoiseTexture2D

@export_group(\"Trauma / Impact\")
@export var decay: float = 0.8
var trauma: float = 0.0
var trauma_power: float = 2.0

var _time: float = 0.0
@onready var initial_rotation: Vector3 = rotation

func _ready() -> void:
	if not noise:
		if noise_texture and noise_texture.noise is FastNoiseLite:
			noise = noise_texture.noise
		else:
			noise = FastNoiseLite.new()
			noise.seed = randi() % 10000
			noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
			noise.frequency = 0.2
			noise.fractal_octaves = 1
	else:
		# Single octave eliminates high-frequency jitter vibrations
		noise.fractal_octaves = 1
	initial_rotation = rotation

func _process(delta: float) -> void:
	_time += motion_speed * delta

	if trauma > 0.0:
		trauma = max(trauma - decay * delta, 0.0)

	_apply_handheld_motion(delta)

func add_trauma(amount: float) -> void:
	trauma = min(trauma + amount, 1.0)

func _apply_handheld_motion(delta: float) -> void:
	var active_noise: FastNoiseLite = noise
	if not active_noise and noise_texture and noise_texture.noise is FastNoiseLite:
		active_noise = noise_texture.noise

	var impact_boost: float = 1.0 + pow(trauma, trauma_power) * 2.0

	# 1. Primary handheld tilt up and down (pitch):
	# Smooth dual-sine breathing wave for human cadence + smooth noise for organic variation
	var breath_wave: float = sin(_time * 1.4) * 0.7 + sin(_time * 0.75 + 1.2) * 0.3
	var n_pitch: float = active_noise.get_noise_2d(400.0, _time * 0.35) if active_noise else 0.0
	var raw_pitch: float = breath_wave * 0.65 + n_pitch * 0.35
	var target_pitch: float = initial_rotation.x + deg_to_rad(max_pitch_deg) * raw_pitch * impact_boost

	# 2. Subtle horizontal sway (yaw) and wrist roll:
	var n_yaw: float = active_noise.get_noise_2d(600.0, _time * 0.25) if active_noise else 0.0
	var target_yaw: float = initial_rotation.y + deg_to_rad(max_yaw_deg) * n_yaw * impact_boost

	var n_roll: float = active_noise.get_noise_2d(800.0, _time * 0.3) if active_noise else 0.0
	var roll_wave: float = sin(_time * 1.0 + 0.6) * 0.3
	var target_roll: float = initial_rotation.z + deg_to_rad(max_roll_deg) * (roll_wave + n_roll * 0.7) * impact_boost

	# Smooth rotation interpolation (prevents sudden snaps and eliminates shake)
	if is_finite(target_pitch) and is_finite(target_yaw) and is_finite(target_roll):
		var target_quat: Quaternion = Quaternion.from_euler(Vector3(target_pitch, target_yaw, target_roll))
		quaternion = quaternion.slerp(target_quat, clampf(rotation_smoothing * delta, 0.0, 1.0))

	# 3. Soft positional bobbing (gentle human hand breathing)
	var n_vert: float = active_noise.get_noise_2d(0.0, _time * 0.35) if active_noise else 0.0
	var target_v: float = vertical_amplitude * (sin(_time * 1.4) * 0.6 + n_vert * 0.4) * impact_boost
	var n_horiz: float = active_noise.get_noise_2d(200.0, _time * 0.25) if active_noise else 0.0
	var target_h: float = horizontal_amplitude * n_horiz * impact_boost

	v_offset = lerpf(v_offset, target_v, clampf(position_smoothing * delta, 0.0, 1.0))
	h_offset = lerpf(h_offset, target_h, clampf(position_smoothing * delta, 0.0, 1.0))

func _input(event: InputEvent) -> void:
	if InputMap.has_action(\"shake\") and event.is_action_pressed(\"shake\"):
		add_trauma(0.6)

func set_driving_view(pos: Vector3, look_at_target: Vector3) -> void:
	global_position = pos
	look_at(look_at_target, Vector3.UP)
	initial_rotation = rotation
"

